import Moat.Sieve

/-! Generated by scripts/export_xy_certificate.py.
Only the displacement table comes from Python. The local conditions and the
infinite-lattice component bound are checked by Lean's kernel. -/

namespace BinaryFormMoat

def xyGood6 (u : Residue 6) : Prop :=
  (({2, 3} : Finset ℕ).filter (fun p => p ∣ u.1.val * u.2.val)).card ≤ 1

def xyLift6 (u : Residue 6) : Point :=
  match u.1.val, u.2.val with
  | 1, 1 => (0, 0)
  | 1, 2 => (0, 1)
  | 1, 3 => (0, 2)
  | 1, 4 => (0, 3)
  | 1, 5 => (0, 4)
  | 2, 1 => (1, 0)
  | 2, 2 => (1, 1)
  | 2, 4 => (1, 3)
  | 2, 5 => (1, 4)
  | 3, 1 => (2, 0)
  | 3, 3 => (0, 0)
  | 3, 5 => (2, 4)
  | 4, 1 => (3, 0)
  | 4, 2 => (3, 1)
  | 4, 4 => (3, 3)
  | 4, 5 => (3, 4)
  | 5, 1 => (4, 0)
  | 5, 2 => (4, 1)
  | 5, 3 => (4, 2)
  | 5, 4 => (4, 3)
  | 5, 5 => (4, 4)
  | _, _ => (0, 0)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
/-- Exhaustive finite verification using kernel reduction, not native evaluation. -/
theorem xy_periodic_certificate : PeriodicPotentialCheck 6 1 xyGood6 xyLift6 := by
  unfold PeriodicPotentialCheck xyGood6
  decide +kernel

/-- A corrupted constant displacement table is rejected by the same finite condition. -/
theorem xy_zero_potential_rejected :
    ¬ PeriodicPotentialCheck 6 1 xyGood6 (fun _ => (0, 0)) := by
  unfold PeriodicPotentialCheck xyGood6
  decide +kernel

/-- An explicit bound for every component of the infinite lattice graph. -/
theorem xy_component_bound_36
    (z : {z : Point // Allowed
      ((MvPolynomial.X (0 : Fin 2) : Form) * MvPolynomial.X (1 : Fin 2)) 1 z}) :
    Set.encard {w | (graph
      ((MvPolynomial.X (0 : Fin 2) : Form) * MvPolynomial.X (1 : Fin 2)) 1 1).Reachable z w}
      ≤ (36 : ℕ∞) := by
  apply component_bound_of_periodic_check _ 1 1 6 xyGood6 xyLift6 _ xy_periodic_certificate z
  intro w hw
  have hp : ∀ p ∈ ({2, 3} : Finset ℕ), p.Prime := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl <;> decide
  have hq : ∀ p ∈ ({2, 3} : Finset ℕ), p ∣ 6 := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl <;> norm_num
  simpa [primeSieve, xyGood6, representative, value, Int.natAbs_mul, -ZMod.natCast_val] using
    allowed_primeSieve _ {2, 3} 6 1 hp hq w hw

end BinaryFormMoat
