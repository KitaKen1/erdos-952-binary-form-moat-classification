  rw [fairEndpointLaw, fairEndpointLaw, hs, ProbabilityTheory.cond, ProbabilityTheory.cond,
    Measure.prod_prod, measure_univ, mul_one, Measure.prod_smul_left,
    Measure.restrict_prod_eq_prod_univ]

