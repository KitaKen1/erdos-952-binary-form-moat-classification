  fun p ρ => rootResidueHom p.val (e p ρ).val

/-- Reindex local labels by actual primes, then enumerate each local root set. -/
def selectedRootEquiv {R : Type*} (P : Finset ℕ) (S : (p : ℕ) → Finset (ZMod p))
