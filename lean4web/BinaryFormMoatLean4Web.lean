  have hpos : 0 ≤ β * c * L / (4 * K * logT) := by positivity
  calc
    _ ≤ (β * c * L / (4 * K * logT)) * (2 * K * (T / L) * logT) :=
      mul_le_mul_of_nonneg_left hquota hpos
    _ = β / 2 * (c * T) := by field_simp; ring
    _ ≤ n := hnum

