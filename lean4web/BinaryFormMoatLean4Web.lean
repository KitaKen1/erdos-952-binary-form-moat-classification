  obtain ⟨Mi, hi⟩ := paperSchedule_inventory_block_threshold f (R + 1) hd g0 hg0 hg064
  obtain ⟨Ms, hs⟩ := paperSchedule_uniform_size_threshold f (R + 1) hd g0 hg0
