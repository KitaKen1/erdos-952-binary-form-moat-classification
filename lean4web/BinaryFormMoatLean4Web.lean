  induction n with
  | zero =>
    refine ⟨Fin.elim0, ?_, ?_, ?_, 0, ?_⟩
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · intro i; exact Fin.elim0 i
    · intro x _ hx; rcases hx with ⟨i, _⟩; exact Fin.elim0 i
