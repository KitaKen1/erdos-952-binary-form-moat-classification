/-- Uniform fixed-size subset of a specified ambient finite set. -/
def relativeSubsetMean {ι : Type*} (C : Finset ι) (r : ℕ) (f : Finset ι → ℝ) : ℝ :=
  (∑ J ∈ C.powersetCard r, f J) / (C.powersetCard r).card

