      ((boxLineWitnessAssignments P S z R).card : ℝ) /
        (Fintype.piFinset (fun p : P => S p)).card ≤ Real.exp (-η ^ 2 * P.card / 2) := by
  intro z hz
  exact dyadic_box_fixed_line_tail f f.natDegree le_rfl (by omega) P hP hne S hcard hroot z hz
