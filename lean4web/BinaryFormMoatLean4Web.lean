    (bad : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 K))) (N : ℕ) :
    ∀ᶠ x : ℝ in atTop, ∃ T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 K)),
