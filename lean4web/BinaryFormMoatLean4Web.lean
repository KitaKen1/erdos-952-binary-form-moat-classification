    (∫ h : J → H, ((passingList reject h).card : ℝ) ∂Measure.pi (fun _ : J => ν)) ≤ 5 * A := by
  have h := expected_passingList_card_le_of_quota ν reject B ε (4 * A) A hfloor hB ht
  linarith

