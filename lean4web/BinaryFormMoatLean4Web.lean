theorem paperCheckpoint_displacement_entropy_le (ν : Measure (PaperTerminalSource A d M g0)) :
    entropy (fun ω => z (paperTerminalTime b d M g0 ω) -
      z (paperCheckpointTime b d M g0 k.castSucc ω)) ν ≤
