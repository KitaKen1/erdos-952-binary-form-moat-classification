  intro v hv
  have h := hT hv
  simp only [Finset.mem_sdiff, S, Finset.mem_filter, TauCeti.mem_normLE] at h
  exact ⟨h.1.2, lt_of_not_ge (fun hn => h.2 ⟨hn, h.1.2⟩), h.1.1⟩

