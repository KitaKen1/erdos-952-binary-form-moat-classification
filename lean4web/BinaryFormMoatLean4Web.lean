  | zero => norm_num [paperScheduleX]
  | succ M ih =>
    rw [paperScheduleX_succ]
    push_cast
    have hx := (paperScheduleX_pos d M hd).le
    nlinarith

theorem paperOperationCap_real_bound (d M : ℕ) (hd : 1 ≤ d) (g0 : ℝ)
    (hg0 : 0 < g0) (hg01 : g0 < 1) :
