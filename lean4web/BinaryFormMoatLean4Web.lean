theorem sum_pair_fiber_real {Ω S T : Type*}
    [MeasurableSpace Ω] [MeasurableSpace S] [MeasurableSingletonClass S]
    [MeasurableSpace T] [MeasurableSingletonClass T] [Fintype T]
    (μ : Measure Ω) [IsFiniteMeasure μ] (E : Ω → S) (Y : Ω → T)
