theorem terminal_shift_ratio_source_bound (a N : ℕ) (T : ℝ)
    (hT : 0 < T) (ha : (a : ℝ) ≤ T) (hN : T ^ 10 ≤ (N : ℝ)) :
    (a : ℝ) / N ≤ 1 / T ^ 9 := by
  have hNr : (0 : ℝ) < N := lt_of_lt_of_le (pow_pos hT 10) hN
