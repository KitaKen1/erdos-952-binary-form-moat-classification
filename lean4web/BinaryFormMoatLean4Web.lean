    (H : Subgroup (L ≃ₐ[K] L)) :
    (Q.under (𝓞 ↥(fixedField H))).ramificationIdx (𝓞 K) = 1 ↔ Q.inertia (L ≃ₐ[K] L) ≤ H := by
  rw [ramificationIdx_under_fixedField_eq_relIndex, Subgroup.relIndex_eq_one]

