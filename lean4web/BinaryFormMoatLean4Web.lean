    (z : ℕ → Point) (R : ℕ)
    (hstep : ∀ t, sqDist (z (t + 1)) (z t) ≤ (R : ℤ))
    (φ : ℕ → Point →+ G) (L B : ℕ → ℕ) (hL : ∀ i, 0 < L i) (n : ℕ)
    (hB : ∀ i < n, 0 < B i) (hblock : ∀ i < n, L (i + 1) = B i * L i)
    (T : ℝ) (hT : 1 ≤ T) (hlong : ∀ i < n, (L (i + 1) : ℝ) ≤ T) :
    (∑ i ∈ Finset.range (n + 1),
