theorem powersetCard_centered_tail_fraction {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : ℕ) (hs : 2 ≤ s) (hsk : s ≤ Fintype.card ι) (w : ι → ℝ)
    (hzero : ∑ i, w i = 0) (W : ℝ) (hW : 0 ≤ W) (hw : ∀ i, |w i| ≤ W)
