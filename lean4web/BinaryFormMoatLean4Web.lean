    (H : Finset Point) (hne : H.Nonempty) (F : J → Point → Q) (ε : ℝ)
    (herr : ((badProjectionIndices H F).card : ℝ) / Fintype.card J ≤ ε) :
    (1 - ε) * Real.log (H.card : ℝ) ≤
      (∑ j, entropy (fun h : H => F j h.val) (uniformOn (Set.univ : Set H))) /
        Fintype.card J := by
