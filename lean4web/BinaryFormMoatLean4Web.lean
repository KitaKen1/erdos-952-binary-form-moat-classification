    _ ≤ μ.real (⋃ x, f x) := measureReal_mono (μ := μ) hs
    _ ≤ ∑ x, μ.real (f x) := measureReal_iUnion_fintype_le f
    _ ≤ ∑ x : G, b := by
      apply Finset.sum_le_sum
      intro x _
      by_cases hx : x ∈ B
