  have hab : (a - c) - (b - c) = a - b := by abel
  have hde : (d - c) - (e - c) = d - e := by abel
  rwa [hab, hde] at ht

theorem prefix_difference_determinant_le (z : ℕ → Point) (N : ℕ) :
    ∀ h ∈ pointDifferences (walkVertexSet z N),
      ∀ g ∈ pointDifferences (walkVertexSet z N),
