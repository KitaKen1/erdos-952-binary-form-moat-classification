      rw [← Nat.choose_succ_right_eq, Nat.mul_comm]
    exact_mod_cast h
  have hden : (0 : ℝ) <
      ((((Finset.univ : Finset ι).powersetCard s).card * (Fintype.card ι - s) : ℕ) : ℝ) := by
    rw [Nat.cast_mul, hcard]
