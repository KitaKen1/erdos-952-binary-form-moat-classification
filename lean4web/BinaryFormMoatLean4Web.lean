/-- The endpoints may be in either time order inside the SAME forward window. -/
theorem two_window_endpoints_displacement_mem (z : ℕ → Point) (D N : ℕ)
    (hstep : ∀ t, |(z (t + 1)).1 - (z t).1| ≤ D ∧
      |(z (t + 1)).2 - (z t).2| ≤ D)
