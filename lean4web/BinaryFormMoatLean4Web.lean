theorem roundedHarper_exp_tail_le (d q r : ℕ) (hd : 1 ≤ d) (hq : 0 < q)
    (η : ℝ) (hη : 0 < η) (hwidth : (q : ℝ) ≤ 9 / η ^ 2) :
