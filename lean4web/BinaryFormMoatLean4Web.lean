    _ = (Nat.choose k q * Nat.choose q (b + 1)) * (b + 1) := by ring
    _ = (Nat.choose k (b + 1) * Nat.choose (k - (b + 1)) (q - (b + 1))) * (b + 1) := by rw [hc]
    _ = Nat.choose (k - (b + 1)) (q - (b + 1)) * (Nat.choose k (b + 1) * (b + 1)) := by ring
    _ = _ := by rw [hk]; ring

