lemma dbcount_outside_door_odd (i : I) : Odd (filter (fun x => isOutsideDoor x.1.1 x.1.2)
    (dbcountingset c i)).card  := by
  obtain ⟨x,hx⟩ := dbcount_outside_door' c i
