    _ ≤ T / N := div_le_div_of_nonneg_right ha hNr.le
    _ ≤ T / T ^ 10 := div_le_div_of_nonneg_left hT.le (pow_pos hT 10) hN
    _ = 1 / T ^ 9 := by
      rw [show T ^ 10 = T ^ 9 * T by ring]
      field_simp

