      simp [h'b]
    · simp
    · rintro ⟨b, bH⟩ _hb h'b
      simp only [ne_eq, Subtype.mk.injEq] at h'b
      simp [h'b]
    · simp
  · simp
  · apply finiteRange_of_finset _ H _
