      ((s + 1 : ℕ) * (E.card : ℝ)) = subsetMean (s + 1) f / (s + 1 : ℕ) := by
    field_simp
  rw [hnorm] at hb
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have htR : (0 : ℝ) < (s + 1 : ℕ) := by positivity
  have hh := (le_div_iff₀ htR).mp hb
  apply (le_div_iff₀ hsR).mpr
  push_cast at hh
  linarith

