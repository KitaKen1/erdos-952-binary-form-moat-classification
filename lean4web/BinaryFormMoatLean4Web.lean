lemma FiniteKernelSupport.prodMkRight {κ : Kernel T S} (hκ : FiniteKernelSupport κ) :
    FiniteKernelSupport (prodMkRight U κ) :=
  hκ.comap _

protected lemma AEFiniteKernelSupport.prodMkRight [MeasurableSingletonClass S]
