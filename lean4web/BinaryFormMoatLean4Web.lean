def fullPointProjection : Point →+ (∀ i, K i) where
  toFun x i := F i x
  map_zero' := by ext i; exact map_zero _
  map_add' x y := by ext i; exact map_add _ _ _

def residuePrefix (S : Finset ι) (X : Ω → Point) : Ω → ((i : S) → K i.val) :=
