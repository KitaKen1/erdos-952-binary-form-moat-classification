theorem entropy_le_log_max_card_of_mem {Ω S : Type*}
    [MeasurableSpace Ω] [MeasurableSpace S] [DiscreteMeasurableSpace S]
    (μ : Measure Ω) (X : Ω → S) (A : Finset S) (hX : Measurable X)
