    Z (t + n) = Z t + ∑ i : Fin n, contribution (wordAt w n t i) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [← Nat.add_assoc, hstep, ih, Fin.sum_univ_castSucc]
    simp only [wordAt, Fin.val_castSucc, Fin.val_last]
    rw [add_assoc]

