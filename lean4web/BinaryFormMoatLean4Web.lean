    linarith [Int.ofNat_le.mpr h_card_le_n]
  · intro x hx y hy i
    exfalso
    exact hσ ⟨x, hx⟩

theorem size_bound_out (σ : Finset (TT n l)) (C : Finset (Fin n)) (h : TT.ILO.isDominant σ C) :
    ∀ x ∈ σ, ∀ i ∉ C, (x i : ℤ) < n + 1
