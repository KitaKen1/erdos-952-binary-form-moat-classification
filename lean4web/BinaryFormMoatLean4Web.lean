    intro i j hij
    by_contra hne
    have he : p i = p j := congrArg Subtype.val hij
    exact Finset.disjoint_left.mp (hdis hne) (hp i) (he.symm ▸ hp j)
  have hc := Fintype.card_le_of_injective f hinj
  simp only [Fintype.card_fin, Fintype.card_coe] at hc
