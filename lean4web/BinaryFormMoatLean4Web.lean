      ((Finset.univ : Finset ι).powersetCard s).card ≤ (s : ℝ) * W ^ 2 := by
  have hn : (0 : ℝ) < Fintype.card ι := by exact_mod_cast (by omega : 0 < Fintype.card ι)
  have hb : (∑ i, (w i) ^ 2) ≤ (Fintype.card ι : ℝ) * W ^ 2 := by
    calc
