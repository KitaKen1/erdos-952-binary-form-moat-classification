    (hcount : P.card = roundedHarperCount (harperQuotaWidth η) r)
    (T : ℕ) (hT : 2 ≤ T) (hpT : ∀ p ∈ P, p ≤ 2 * T)
    (hgap : Real.log (max 1 (4 * (D * N)) : ℕ) +
      Real.log (coefficientBound f f.natDegree : ℝ) / f.natDegree +
      η * P.card * Real.log (T : ℝ) ≤ ∑ p ∈ P, Real.log (p : ℝ))
