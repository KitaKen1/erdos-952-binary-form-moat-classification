    ((((Finset.univ : Finset ι).powersetCard s).filter
      (fun A => a ≤ |∑ i ∈ A, w i|)).card : ℝ) /
      ((Finset.univ : Finset ι).powersetCard s).card ≤ (s : ℝ) * W ^ 2 / a ^ 2 := by
