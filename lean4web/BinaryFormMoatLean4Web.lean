    (((MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℤ)^2 +
      MvPolynomial.X 1^2).eval ![z.1, z.2])}) _ R hQ
  intro z hz
  simpa [Zsqrtd.norm, pow_two] using gaussian_prime_norm_fewPrimeFactors
