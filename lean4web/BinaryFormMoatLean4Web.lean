    (fun p hp ρ hρ => (mem_primeRootSet f p (batch.primes p hp).1 ρ).mp hρ) e
    hT batch.nonempty (fun p hp => (batch.primes p hp).2.1)
    (fun p hp => (batch.primes p hp).2.2.1) batch.top z a k
