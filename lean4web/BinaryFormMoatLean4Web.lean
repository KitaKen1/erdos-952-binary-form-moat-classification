  · rw [IsUniform.measure_preimage_of_mem hX_unif' hX h,
      IsUniform.measure_preimage_of_mem hX'_unif' hX' h]
    simp
  · rw [IsUniform.measure_preimage_of_nmem hX_unif' h,
      IsUniform.measure_preimage_of_nmem hX'_unif' h]

