    _ ≤ ((good.card : ℝ) / C.card) * L := mul_le_mul_of_nonneg_right hf hL
    _ = ((good.card : ℝ) * L) / C.card := by ring
    _ ≤ _ := div_le_div_of_nonneg_right hs hC.le

