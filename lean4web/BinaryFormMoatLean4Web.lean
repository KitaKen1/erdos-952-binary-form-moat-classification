    rw [abs_le]
    obtain ⟨hli, hhi⟩ := hw i
    dsimp [v, m]
    constructor <;> linarith
  have hzero : ∑ i, v i = 0 := by
    simp only [v, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    dsimp [m]
    field_simp
