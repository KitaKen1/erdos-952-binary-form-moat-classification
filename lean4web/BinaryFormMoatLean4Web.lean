theorem allowed_mem_blockAvoid (F : Form) (r : ℕ)
    (P : Fin (r + 1) → Finset ℕ)
    (hP : ∀ i, ∀ p ∈ P i, p.Prime)
    (hdis : Pairwise (fun i j => Disjoint (P i) (P j)))
