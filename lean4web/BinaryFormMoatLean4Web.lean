theorem disjoint_subsetMean_eq {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b r : ℕ) (hbr : b + r ≤ Fintype.card ι) (f : Finset ι → ℝ) :
    subsetMean b (fun S => relativeSubsetMean (Finset.univ \ S) r f) = subsetMean r f := by
