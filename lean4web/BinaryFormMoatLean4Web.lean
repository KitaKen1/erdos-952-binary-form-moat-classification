    field_simp [ne_of_gt hc]
  rw [he']
  apply (div_le_iff₀ hc).mpr
  have hn : -δ ^ 2 * (Fintype.card ι : ℝ) * r / 2 ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg
      (mul_nonpos_of_nonpos_of_nonneg
