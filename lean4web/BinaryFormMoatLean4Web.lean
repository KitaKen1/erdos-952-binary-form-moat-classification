    (∑ i ∈ Q \ S, condEntropy (fun ω => F i (X ω))
      (residueDifferenceObservation K F S X Y) μ) ≤
    ∑ i ∈ Q \ S, (condEntropy (fun ω => F i (X ω)) (residuePrefix K F S X) μ +
      condEntropy (fun ω => F i (Y ω)) (residuePrefix K F S Y) μ) := by
