      Measure.pi (fun _ : J => ν a) := by
  rw [continuationResamplingLaw_cond_fiber ρ ν a ha,
    Measure.map_map measurable_snd (measurable_of_finite _)]
  simp only [Function.comp_def, Measure.map_id']

