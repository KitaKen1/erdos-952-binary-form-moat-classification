    [MeasurableSpace Ω] [MeasurableSpace S] [Fintype S]
    [MeasurableSpace T] [Fintype T]
    (μ : Measure Ω) (X : Ω → S) (Z : Ω → T) (L : T → Finset S) : ℝ :=
