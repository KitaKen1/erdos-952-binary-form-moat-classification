    rw [abs_sub_comm (z t).1 (z v).1] at h
    exact (h.trans (add_le_add hx.1 hy.1)).trans_eq he
  · have h := abs_sub_le (z u).2 (z t).2 (z v).2
    rw [abs_sub_comm (z t).2 (z v).2] at h
    exact (h.trans (add_le_add hx.2 hy.2)).trans_eq he

