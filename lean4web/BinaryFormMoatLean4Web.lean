  have hscale : 2 * (π : ℂ) * A * ((2 * π : ℂ)⁻¹ * ∫ y in Ioi 0, Ψ y) =
      A * ∫ y in Ioi 0, Ψ y := by
    field_simp
  rw [hFg, hg0, hscale] at key
  refine key.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with x hx
